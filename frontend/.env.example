# ==============================================================
# FRONTEND VITE ENVIRONMENT TEMPLATE
# Lưu ý: Các biến có tiền tố VITE_ sẽ được đóng gói công khai
# vào mã nguồn JavaScript gửi tới trình duyệt người dùng.
# TUYỆT ĐỐI KHÔNG ĐẶT SECRET KEY HOẶC MẬT KHẨU TẠI ĐÂY!
# ==============================================================
# Địa chỉ backend server cho dev proxy (mặc định: http://localhost:8080)
# Nếu phát triển kết nối trực tiếp với server hosting từ xa:
# VITE_API_TARGET=https://api.yourdomain.com
VITE_API_TARGET=http://localhost:8080

VITE_API_BASE_URL=/api
VITE_APP_TITLE=System Inverter Likenew
VITE_ENABLE_DEBUG=false

