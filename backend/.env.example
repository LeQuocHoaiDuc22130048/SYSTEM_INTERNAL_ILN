# ==============================================================
# BACKEND ENVIRONMENT TEMPLATE (Lưu trên Git làm tài liệu mẫu)
# ==============================================================
SPRING_PROFILES_ACTIVE=dev

# Database
DB_NAME=system_internal_db
DB_USERNAME=admin
DB_PASSWORD=your_secure_db_password_here

# Khởi tạo tài khoản hệ thống (Lần đầu chạy migrate/init)
SUPER_ADMIN_USERNAME=super_admin
SUPER_ADMIN_PASSWORD=Your_SuperAdmin_Password!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Your_Admin_Password!

# Tài khoản MinIO Storage
MINIO_USER=minio_access_key
MINIO_PASSWORD=your_secure_minio_password

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=system-internal-likenew

# JWT Secret Key (Tối thiểu 32 ký tự, khuyến nghị chuỗi Base64 512-bit)
JWT_SECRET_KEY=replace_with_your_strong_random_jwt_secret_key_here

# Dịch vụ nhận diện khuôn mặt
FACE_SERVICE_URL=http://face-service:8001

# CORS Allowed Origins (Phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=https://inverterlikenew.com,http://localhost:5173
